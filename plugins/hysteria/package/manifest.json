{
  "schema": 1,
  "id": "hysteria",
  "name": "Hysteria2 服务端",
  "version": "1.0.4",
  "desc": "Hysteria2 服务端（mini-sb-agent / sing-box 内核）",
  "protocol": 1,
  "interpreter": {
    "name": "sh"
  },
  "exec": {
    "path": "payload/bin/hysteria.sh",
    "args": [
      "start"
    ],
    "ready": "exec"
  },
  "lifecycle": {
    "stop": {
      "path": "payload/bin/hysteria.sh",
      "args": [
        "stop"
      ]
    },
    "status": {
      "path": "payload/bin/hysteria.sh",
      "args": [
        "status"
      ]
    }
  },
  "config": "config/config",
  "capabilities": []
}
