{
  "schema": 1,
  "id": "sshd",
  "name": "SSH 与 SFTP 服务",
  "version": "1.0.1",
  "desc": "dropbear + sftp-server：SSH 与 SFTP 服务",
  "protocol": 1,
  "interpreter": {
    "name": "sh"
  },
  "exec": {
    "path": "payload/bin/sshd.sh",
    "args": [
      "start"
    ],
    "ready": "exec"
  },
  "lifecycle": {
    "stop": {
      "path": "payload/bin/sshd.sh",
      "args": [
        "stop"
      ]
    },
    "status": {
      "path": "payload/bin/sshd.sh",
      "args": [
        "status"
      ]
    }
  },
  "config": "config/config",
  "capabilities": []
}
