{
  "name": "sshd",
  "version": "1.0.0",
  "desc": "dropbear + sftp-server：SSH 与 SFTP 服务",
  "protocol": 1,
  "interpreter": {
    "name": "sh"
  },
  "exec": {
    "path": "payload/bin/sshd.sh"
  },
  "capabilities": [
    {
      "name": "start",
      "desc": "启动 dropbear（并部署 sftp-server）",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "stop",
      "desc": "停止 dropbear",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "status",
      "desc": "查询运行状态（running / pid / port）",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
