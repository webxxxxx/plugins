{
  "schema": 1,
  "id": "sshfs",
  "name": "SSHFS 挂载",
  "version": "1.2.0",
  "desc": "通过 sshfs 挂载远端目录：四个二进制打包前从源码编译，Linux 全平台通用",
  "protocol": 1,
  "interpreter": {
    "name": "sh"
  },
  "exec": {
    "path": "payload/bin/sshfs.sh",
    "args": [
      "start"
    ],
    "ready": "exec"
  },
  "lifecycle": {
    "stop": {
      "path": "payload/bin/sshfs.sh",
      "args": [
        "stop"
      ]
    },
    "status": {
      "path": "payload/bin/sshfs.sh",
      "args": [
        "status"
      ]
    }
  },
  "config": "config/config",
  "capabilities": []
}
