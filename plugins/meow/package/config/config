# meow 插件的设置：meow 自己不读这个文件，也不会改它（订阅和规则在 meow.yaml 里）。
# 改完 `plugin restart meow` 生效。
proxy-mode: pc

# 本机 mixed 代理端口（HTTP + SOCKS 同一个口）。
mixed-port: 7890

# 透明代理端口：Linux 的 pc / router 形态用；Windows 走 TUN，不看这个。
tproxy-port: 7893
# meow 自己出向的 SO_MARK，避免被自己的规则再抓一次（Linux pc 形态）。
routing-mark: 9527

# router 形态：被劫持的 LAN 网口，以及劫持 LAN DNS 用的端口。
lan-interface: br0
dns-port: 1053
