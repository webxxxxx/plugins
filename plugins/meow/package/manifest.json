{
  "name": "meow",
  "version": "1.0.0",
  "desc": "meow 代理：mihomo 内核，带 yacd 面板",
  "protocol": 1,
  "interpreter": {
    "name": "sh"
  },
  "exec": {
    "path": "payload/bin/meow.sh"
  },
  "lifecycle": {
    "start": {
      "path": "payload/bin/meow.sh",
      "args": ["start"]
    },
    "stop": {
      "path": "payload/bin/meow.sh",
      "args": ["stop"]
    },
    "status": {
      "path": "payload/bin/meow.sh",
      "args": ["status"]
    }
  },
  "capabilities": []
}
