{
  "schema": 1,
  "id": "meow",
  "name": "meow 代理",
  "version": "1.0.1",
  "desc": "meow 代理：mihomo 兼容内核，带 yacd 面板",
  "protocol": 1,
  "interpreter": {
    "name": "sh"
  },
  "exec": {
    "path": "payload/bin/meow.sh",
    "ready": "exec"
  },
  "lifecycle": {
    "start": {
      "path": "payload/bin/meow.sh",
      "args": [
        "start"
      ]
    },
    "stop": {
      "path": "payload/bin/meow.sh",
      "args": [
        "stop"
      ]
    },
    "status": {
      "path": "payload/bin/meow.sh",
      "args": [
        "status"
      ]
    }
  },
  "ui": {
    "type": "web",
    "entry": "index.html"
  },
  "config": "config/config",
  "capabilities": []
}
