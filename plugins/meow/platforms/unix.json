{
  "interpreter": {
    "name": "sh"
  },
  "exec": {
    "path": "payload/bin/meow.sh",
    "ready": "notify"
  },
  "lifecycle": {
    "start": {
      "path": "payload/bin/meow.sh",
      "args": [
        "start"
      ]
    },
    "stop": {
      "path": "payload/bin/meow.sh",
      "args": [
        "stop"
      ]
    },
    "status": {
      "path": "payload/bin/meow.sh",
      "args": [
        "status"
      ]
    }
  }
}
