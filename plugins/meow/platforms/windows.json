{
  "interpreter": {
    "name": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File"
    ]
  },
  "exec": {
    "path": "payload/bin/meow.ps1",
    "args": [
      "start"
    ],
    "ready": "notify"
  },
  "lifecycle": {
    "stop": {
      "path": "payload/bin/meow.ps1",
      "args": [
        "stop"
      ]
    },
    "status": {
      "path": "payload/bin/meow.ps1",
      "args": [
        "status"
      ]
    }
  }
}
