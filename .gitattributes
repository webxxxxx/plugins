# Shell payloads must stay LF: a CRLF shebang makes the kernel look for
# "/bin/sh\r", and the packer rejects CR in hooks. Windows checkouts are the
# normal case here, so pin it rather than depend on core.autocrlf.
* text=auto
*.sh   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.spk  binary
*.pem  binary
*.pub  binary

# 随包发布的内核模块：任何 eol 转换都会破坏 SHA256SUMS 与可执行文件。
# vendor/ 下的其余内容是源码，按文本处理（*.rs/*.c 等走 text=auto）。
# 源码 tarball 必须是原字节：eol 转换会直接毁掉 gzip/xz 流。
*.ko   binary
*.tar.gz  binary
*.tar.bz2 binary
*.tar.xz  binary
plugins/*/vendor/prebuilt/* binary
plugins/*/vendor/prebuilt/*/SHA256SUMS -binary text eol=lf

# 变体单元的 SHA256SUMS 与内核模块。清单里的名字是给 `cd <unit> && sha256sum -c`
# 用的：CRLF 会给名字尾巴添一个 \r，Windows 检出就校验不过。
plugins/*/variants/*/SHA256SUMS text eol=lf
*.py   text eol=lf
