{
  "schema": 1,
  "id": "hello-shell",
  "name": "Shell 示例插件",
  "version": "1.0.0",
  "desc": "Shell reference plugin: blob and file package transfer",
  "protocol": 1,
  "icons": { "png": "payload/icons/icon.png" },
  "interpreter": { "name": "sh" },
  "exec": {
    "path": "payload/bin/hello-shell.sh",
    "ready": "notify"
  },
  "ui": {
    "type": "web",
    "entry": "index.html"
  },
  "capabilities": [
    {
      "name": "echo",
      "desc": "Echo a message back, prefixed with the configured greeting",
      "inputSchema": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "required": ["message"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_stats",
      "desc": "Counters and uptime as a JSON object",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "calls": { "type": "integer" },
          "uptime_secs": { "type": "integer" },
          "pid": { "type": "integer" }
        },
        "required": ["calls", "uptime_secs", "pid"]
      }
    },
    {
      "name": "count_text",
      "desc": "Summarize a large text blob (streams it instead of loading it)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": { "$blob": { "type": "string" } },
            "required": ["$blob"],
            "additionalProperties": false
          }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_file_info",
      "desc": "Stream a file package (parts + manifest) and verify its declared size",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": { "$file": { "type": "string" } },
            "required": ["$file"],
            "additionalProperties": false
          }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    },
    {
      "name": "create_report",
      "desc": "Produce a report as a blob; the host stores it and returns a resource_link",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    }
  ]
}
