{
  "schema": 2,
  "name": "hello-rust",
  "version": "0.1.0",
  "desc": "Rust 最小插件：能力 + 定时通知 + Web UI",
  "protocol": 1,
  "exec": {
    "path": "payload/bin/hello-rust",
    "ready": "notify"
  },
  "ui": {
    "type": "web",
    "entry": "index.html"
  },
  "capabilities": [
    {
      "name": "echo",
      "desc": "Echo a message back to the caller",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"],
        "additionalProperties": false
      }
    },
    {
      "name": "stats",
      "desc": "How many ticks this plugin has seen",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
