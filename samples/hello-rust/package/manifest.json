{
  "schema": 1,
  "id": "hello-rust",
  "name": "Rust 示例插件",
  "version": "1.0.0",
  "desc": "Reference plugin: capabilities, notifications, chunked file transfer",
  "protocol": 3,
  "icons": { "png": "payload/icons/icon.png" },
  "exec": {
    "path": "payload/bin/hello-rust",
    "ready": "notify"
  },
  "ui": {
    "type": "web",
    "entry": "index.html"
  },
  "capabilities": [
    {
      "name": "echo",
      "desc": "Echo a message back, prefixed with the configured greeting",
      "inputSchema": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "required": ["message"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_stats",
      "desc": "Counters and uptime as a JSON object",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "greeting": { "type": "string" },
          "calls": { "type": "integer" },
          "ticks": { "type": "integer" },
          "uptime_secs": { "type": "integer" }
        },
        "required": ["greeting", "calls", "ticks", "uptime_secs"]
      }
    },
    {
      "name": "count_text",
      "desc": "Summarize a large text blob (streams it instead of loading it)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": { "$blob": { "type": "string" } },
            "required": ["$blob"],
            "additionalProperties": false
          }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_file_info",
      "desc": "Stream a file package (parts + manifest) and verify its declared size",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": { "$file": { "type": "string" } },
            "required": ["$file"],
            "additionalProperties": false
          }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    },
    {
      "name": "create_report",
      "desc": "Produce a report as a blob; the host stores it and returns a resource_link",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    }
  ]
}
